{
    "version": "2.0.0",
    "options": {
        "env": {
            "PATH": "${env:HOME}/tools/cmake-3.31.6-macos-universal/CMake.app/Contents/bin:${env:PATH}"
        }
    },
    "tasks": [
        {
            "label": "cmake:configure (Debug)",
            "type": "shell",
            "command": "cmake -B build -S . -DCMAKE_BUILD_TYPE=Debug",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "cmake:configure (Release)",
            "type": "shell",
            "command": "cmake -B build -S . -DCMAKE_BUILD_TYPE=Release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "build (Debug)",
            "type": "shell",
            "command": "cmake -B build -S . -DCMAKE_BUILD_TYPE=Debug && cmake --build build -j 8",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build (Release)",
            "type": "shell",
            "command": "cmake -B build -S . -DCMAKE_BUILD_TYPE=Release && cmake --build build -j 8",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "run",
            "type": "shell",
            "command": "cmake -B build -S . -DCMAKE_BUILD_TYPE=Release && cmake --build build -j 8 && ./build/Renderer",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "rm -rf build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
